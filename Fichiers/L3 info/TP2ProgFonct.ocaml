let l = [5;2;6;7];;

let l2 = [2;2;5;5];;

let ll = [[1;2;3];[4;5;4];[3;2;1]];;

let rec longueur = function l -> match l with
                            []->0
                            |x::r -> 1+longueur r;;

longueur l;;

let rec concat l1 l2 = match l1 with
                []-> l2
                |x::r->x::concat r l2;;

concat l l2;;

let rec nieme n l = match (l,n) with
                [],_-> -1
                |x::r,0-> -1
                |x::r,1-> x
                |x::r,_-> nieme (n-1) r;;

nieme 3 l;;

let rec npremiers n l = match (l,n) with
                    [],_-> []
                    |_,0-> []
                    |x::r,_-> x::npremiers (n-1) r;;

npremiers 3 l;;

let rec met_a_plat l = match l with
                []-> []
                |x::r-> x @ met_a_plat r;;

met_a_plat ll;;

let cl = ([1;2;3],['a';'b';'c']);;

let rec paire_vers_liste (x,y) = match (x,y) with
                            [],[]->[]
                            |x::r1,y::r2-> (x,y)::paire_vers_liste (r1,r2)
                            |_,_-> failwith "pas le meme nombre d'arguments dans chaque couple";;


let lc = paire_vers_liste cl;;

let rec liste_vers_paire l = match l with
                        []->([],[])
                        |(x,y)::r-> let (l1,l2) = liste_vers_paire r in
                                    (x::l1,y::l2);;

liste_vers_paire lc;;

let rec supprime1 x l = match l with
                    []->[]
                    |e::r-> if x=e then r
                                else e::supprime1 x r;;

let l = supprime1 2 l;;

let rec supprime2 x l = match l with
                    []->[]
                    |e::r-> if x=e then supprime2 x r
                                else e::supprime2 x r;;

let l2 = supprime2 2 l2;;

let min_liste l = let rec min_liste2 x l = match l with []->x
                                        |e::r-> if e<x then min_liste2 e r
                                                else min_liste2 x r in
                match l with []-> failwith "liste vide"
                |x::r->min_liste2 x r;;

min_liste l;;

let rec doublon l = let rec verif l x = match l with []->false
                                        |e::r-> if e=x then true
                                                else verif r x in
match l with []->[]
|x::r -> if verif r x then doublon r
            else x::(doublon r);;

doublon l2;;